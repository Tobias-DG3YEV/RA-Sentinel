add_cells_to_pblock [get_pblocks  {CLKAG_video_clk0/inst/o_clk_195M_Video_clk_en_clk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="video_clk0/inst/o_clk_195M_Video_clk_en_clk"}]]]
resize_pblock [get_pblocks {CLKAG_video_clk0/inst/o_clk_195M_Video_clk_en_clk}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1}
#endgroup

